#!/usr/bin/env bash
#
# Link this repository's skills and rules into a harness, one symlink per
# entry, touching only entries this repository owns.
#
# A harness scans only the top level of its skills directory, so a skill
# nested in a category folder is invisible to it. Claude Code loads every
# .md under ~/.claude/rules/ into every session, and follows symlinks to
# find them. Both kinds reach the harness the same way: the repository
# organizes its entries however it likes, and the links flatten them at
# the boundary.
#
# Skills with reach `all` are deliberately NOT linked. Each skill says
# where it can be used through `metadata.reach` in its front matter (see
# bin/lib/skill-meta.sh). A reach `all` skill is uploaded by hand to the
# Claude account, and Claude Code syncs account skills into every session
# on its own, as anthropic-skills:<name>. Linking it here as well would
# list it twice in every session, so this script leaves it to the sync.
# The cost: an edit to an `all` skill is not live locally until it is
# uploaded. To try an edit before then, link it on purpose with
# --include-all and accept the duplicate until the next plain --prune run
# removes it. Why the upload is by hand and how it is gated:
# .github/workflows/account-upload.yml.
#
# Safe to re-run. Nothing is touched until every kind has passed its
# checks, and a failure in one kind does not stop the other.

set -euo pipefail

PROG=link

# The checkout this script lives in, found from its own path (so the
# working directory plays no part). Every link points under it: skills/
# for skills, rules/ for rules. That is why a worktree checkout must not
# run for real.
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source-path=SCRIPTDIR source=lib/skill-meta.sh
. "$REPO_ROOT/bin/lib/skill-meta.sh"

# The kinds of entry, in the order they are linked. --skip validates
# against this list, and every per-kind function below is named after it.
KINDS=(skills rules)

# Where each kind lands. The environment sets the machine's default,
# --skills-target and --rules-target override it for one run.
SKILLS_TARGET="${JAKE_MODE_SKILLS_TARGET:-$HOME/.claude/skills}"
RULES_TARGET="${JAKE_MODE_RULES_TARGET:-$HOME/.claude/rules}"

# Command-line switches. parse_args sets them; link_kind and say read
# them. All off by default: a bare run links what is missing and stops at
# anything it does not own.
DRY_RUN=0   # --dry-run: print every action as "would ...", touch nothing
PRUNE=0     # --prune: also remove our own links whose entry no longer exists
FORCE=0     # --force: replace entries this repo does not own
SKIP=()     # --skip: kinds to leave alone entirely
INCLUDE_ALL=0  # --include-all: link reach `all` skills too (see the top)

# Totals across every kind, for the summary line and the exit status.
LINKED=0 CURRENT=0 SKIPPED=0 PRUNED=0 FAILED=0

# The entries of the kind most recently passed to collect, as absolute
# source paths. Filled once per kind for the checks and again for the
# linking; find is cheap and it saves keeping one array per kind.
entries=()

main() {
  parse_args "$@"

  local active=() kind
  for kind in "${KINDS[@]}"; do
    skipped "$kind" || active+=("$kind")
  done
  if [ "${#active[@]}" -eq 0 ]; then
    usage_error "every kind is skipped, nothing to link"
  fi

  # Every check for every kind, before anything is touched.
  if [ "$DRY_RUN" -eq 0 ] && in_worktree; then
    local main_root; main_root="$(cd "$(dirname "$(git -C "$REPO_ROOT" rev-parse --git-common-dir)")" && pwd)"
    printf '%s: this checkout is a git worktree; links into it break when it is removed.\n' "$PROG" >&2
    printf 'Run from the main checkout instead: %s\n' "$main_root" >&2
    exit 1
  fi
  for kind in "${active[@]}"; do
    preflight "$kind"
  done

  local first=1
  for kind in "${active[@]}"; do
    [ "$first" -eq 1 ] || echo
    first=0
    link_kind "$kind"
  done

  printf '\n%s: %d linked, %d already current, %d left to account sync, %d pruned, %d failed\n' \
    "$([ "$DRY_RUN" -eq 1 ] && echo 'dry run' || echo 'done')" \
    "$LINKED" "$CURRENT" "$SKIPPED" "$PRUNED" "$FAILED"

  [ "$FAILED" -eq 0 ]
}

# Read the command-line options into the targets, DRY_RUN, PRUNE, FORCE
# and SKIP. Takes "$@". Exits 0 after printing --help, 2 on an unknown
# option or kind; anything else returns normally with the globals updated.
parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --skills-target) SKILLS_TARGET="${2:?--skills-target needs a directory}"; shift 2 ;;
      --rules-target)  RULES_TARGET="${2:?--rules-target needs a directory}"; shift 2 ;;
      --skip)
        known_kind "${2:-}" || usage_error "unknown kind: '${2:-}' (kinds: ${KINDS[*]})"
        SKIP+=("$2"); shift 2 ;;
      -n|--dry-run) DRY_RUN=1; shift ;;
      --prune)      PRUNE=1; shift ;;
      -f|--force)   FORCE=1; shift ;;
      --include-all) INCLUDE_ALL=1; shift ;;
      -h|--help)    usage; exit 0 ;;
      *) usage_error "unknown option: $1" ;;
    esac
  done
}

# Print the help text. Targets show as resolved for this machine, so the
# help doubles as a check of the environment variables.
usage() {
  cat <<USAGE
Usage: bin/$PROG [options]

Link every skill under skills/ and every rule under rules/ into a harness,
one symlink per entry. Kinds, and where they go on this machine:

  skills   every directory holding a SKILL.md, flattened under its own name,
           except skills with reach \`all\` (Claude account sync delivers those)
           -> ${SKILLS_TARGET/#$HOME/~}  (\$JAKE_MODE_SKILLS_TARGET)
  rules    every .md file
           -> ${RULES_TARGET/#$HOME/~}  (\$JAKE_MODE_RULES_TARGET)

Options:
      --skills-target DIR  Harness skills directory for this run
      --rules-target DIR   Harness rules directory for this run
      --skip KIND          Leave one kind alone (skills or rules); repeatable
  -n, --dry-run            Print what would change, touch nothing
      --prune              Remove links into this repo whose entry no longer exists
  -f, --force              Replace a conflicting entry that this repo does not own
      --include-all        Also link reach \`all\` skills, to try an edit before
                           uploading it (they then show up twice)
  -h, --help              Show this message

Nothing is touched until every kind passes its checks. Exit status is 1 if
any entry could not be linked, 2 for a usage error.
USAGE
}

# Complain about the command line, print the usage, exit 2.
usage_error() {
  printf '%s: %s\n\n' "$PROG" "$*" >&2
  usage >&2
  exit 2
}

# Complain and exit 1. For failures before anything is touched.
die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

# Is the given name one of KINDS? Returns 0 if so.
known_kind() {
  local k; for k in "${KINDS[@]}"; do [ "$k" = "$1" ] && return 0; done
  return 1
}

# Was the given kind passed to --skip? Returns 0 if so. The expansion
# guards against an empty SKIP, which bash 3 rejects under set -u.
skipped() {
  local k; for k in ${SKIP[@]+"${SKIP[@]}"}; do [ "$k" = "$1" ] && return 0; done
  return 1
}

# The checks for one kind, all of which exit 1 before anything is touched:
# its source directory exists, it has at least one entry, and no two
# entries share a basename (they would collide at the flat boundary).
preflight() {
  local kind="$1" source; source="$("${kind}_source")"

  [ -d "$source" ] || die "no ${source#"$REPO_ROOT/"}/ directory at $source"

  collect "$kind"
  [ "${#entries[@]}" -gt 0 ] || die "no $kind found under $source"

  local dupes
  dupes="$(for e in "${entries[@]}"; do basename "$e"; done | sort | uniq -d)"
  if [ -n "$dupes" ]; then
    printf '%s: duplicate %s names, these collide when flattened:\n' "$PROG" "$kind" >&2
    printf '%s\n' "$dupes" | sed 's/^/  /' >&2
    exit 1
  fi
}

# Fill entries with the given kind's entries, sorted by path.
collect() {
  entries=()
  local e
  while IFS= read -r e; do
    entries+=("$e")
  done < <("${1}_entries")
}

# The main loop for one kind: make its target hold one link per entry.
#
# For each entry, the destination TARGET/<basename> ends up as a link to it,
# unless the destination is owned by something else, in which case it is
# left alone and reported (see the conflict, worktree and dangling messages).
# --force overrides that. With --prune, a link into the kind's source
# directory is removed when its target is no longer an entry (the skill or
# rule was renamed or deleted; <kind>_live decides). Every action is printed
# through say, so --dry-run shows the full plan.
#
# Adds to the LINKED, CURRENT, PRUNED and FAILED totals.
link_kind() {
  local kind="$1" target source
  target="$("${kind}_target")"
  source="$("${kind}_source")"
  collect "$kind"

  printf '%s -> %s\n' "$kind" "$target"

  if [ ! -d "$target" ]; then
    say "create $target"
    [ "$DRY_RUN" -eq 1 ] || mkdir -p "$target"
  fi

  local src name dest resolved problem

  for src in "${entries[@]}"; do
    name="$(basename "$src")"
    dest="$target/$name"

    if ! "${kind}_wanted" "$src"; then
      SKIPPED=$((SKIPPED + 1))
      if [ -L "$dest" ] && [ "$(link_target "$dest")" = "$src" ] && [ "$PRUNE" -eq 0 ]; then
        printf 'skip %s (%s), but an earlier link is still there; --prune removes it\n' \
          "$name" "$("${kind}_unwanted_reason")"
      else
        printf 'skip %s (%s)\n' "$name" "$("${kind}_unwanted_reason")"
      fi
      continue
    fi

    if [ -L "$dest" ]; then
      resolved="$(link_target "$dest")"
      if [ ! -e "$resolved" ]; then
        problem="dangling: $dest points at $resolved, which no longer exists"
      elif into_worktree "$resolved"; then
        problem="worktree: $dest links into a git worktree ($resolved) and dies with it; relink from the main checkout"
      elif [ "$resolved" = "$src" ]; then
        CURRENT=$((CURRENT + 1))
        continue
      else
        problem="conflict: $dest is a link to $resolved, not ours"
      fi
      if [ "$FORCE" -eq 0 ]; then
        printf '%s (use --force)\n' "$problem" >&2
        FAILED=$((FAILED + 1))
        continue
      fi
      say "replace link $name"
      [ "$DRY_RUN" -eq 1 ] || rm "$dest"
    elif [ -e "$dest" ]; then
      if same_content "$dest" "$src"; then
        say "adopt $name (identical copy, replacing it with a link)"
      elif [ "$FORCE" -eq 0 ]; then
        printf 'conflict: %s already exists and is not a symlink (use --force)\n' "$dest" >&2
        FAILED=$((FAILED + 1))
        continue
      else
        say "replace $name"
      fi
      [ "$DRY_RUN" -eq 1 ] || rm -rf "$dest"
    fi

    say "link $name -> $src"
    [ "$DRY_RUN" -eq 1 ] || ln -s "$src" "$dest"
    LINKED=$((LINKED + 1))
  done

  [ "$PRUNE" -eq 1 ] || return 0
  for dest in "$target"/*; do
    [ -L "$dest" ] || continue
    resolved="$(link_target "$dest")"
    case "$resolved" in
      "$source"/*) ;;
      *) continue ;;
    esac
    "${kind}_live" "$resolved" && "${kind}_wanted" "$resolved" && continue
    say "prune $(basename "$dest") (was $resolved)"
    [ "$DRY_RUN" -eq 1 ] || rm "$dest"
    PRUNED=$((PRUNED + 1))
  done
}

# Each kind is six functions: where its entries live in the repository,
# where they go in the harness, how to list them, whether a path is still
# one of them, whether an entry should be linked at all, and the reason
# printed when it is not. --prune removes a link whose target fails either
# of the middle two. A third kind is six more functions and a name in KINDS.

# skills: any directory holding a SKILL.md, however deeply nested. A skill
# with reach `all` is not linked unless --include-all is given; the top of
# this file says why.
skills_source()  { printf '%s\n' "$REPO_ROOT/skills"; }
skills_target()  { printf '%s\n' "$SKILLS_TARGET"; }
skills_entries() {
  local manifest
  while IFS= read -r manifest; do
    (cd "$(dirname "$manifest")" && pwd)
  done < <(find "$REPO_ROOT/skills" -type f -name SKILL.md | sort)
}
skills_live()    { [ -f "$1/SKILL.md" ]; }
skills_wanted()  { [ "$INCLUDE_ALL" -eq 1 ] || [ "$(skill_reach "$1")" != all ]; }
skills_unwanted_reason() { printf 'reach all: Claude account sync delivers it'; }

# rules: any .md file under rules/.
rules_source()  { printf '%s\n' "$REPO_ROOT/rules"; }
rules_target()  { printf '%s\n' "$RULES_TARGET"; }
rules_entries() {
  local rule
  while IFS= read -r rule; do
    printf '%s/%s\n' "$(cd "$(dirname "$rule")" && pwd)" "$(basename "$rule")"
  done < <(find "$REPO_ROOT/rules" -type f -name '*.md' | sort)
}
rules_live()    { [ -f "$1" ]; }
rules_wanted()  { return 0; }
rules_unwanted_reason() { :; }

# Is this checkout a git worktree? Returns 0 if so. Links into a worktree
# die with it, so main refuses a real run when this is true.
in_worktree() { into_worktree "$REPO_ROOT"; }

# Does the given path live inside a git worktree, of any repository?
# Returns 0 if so, 1 for a main checkout or a path outside any repository.
# A file's directory is what gets asked. The test: in a main checkout
# --git-dir and --git-common-dir are the same directory; in a worktree they
# differ. Both are forced absolute, since from a subdirectory git prints
# one relative and the other not.
into_worktree() {
  local dir="$1" git_dir common
  [ -d "$dir" ] || dir="$(dirname "$dir")"
  { read -r git_dir && read -r common; } < <(
    git -C "$dir" rev-parse --path-format=absolute --git-dir --git-common-dir 2>/dev/null
  ) || return 1
  [ -n "$common" ] && [ "$git_dir" != "$common" ]
}

# Report an action, prefixed with "would" under --dry-run. Every change
# link_kind makes goes through here first, so the dry run is the plan.
say() { [ "$DRY_RUN" -eq 1 ] && printf 'would %s\n' "$*" || printf '%s\n' "$*"; }

# Print the absolute path the given symlink points at, resolving a relative
# target against the link's own directory. Links this script writes are
# always absolute, which is what the ownership and prune checks compare on.
link_target() {
  local raw; raw="$(readlink "$1")"
  case "$raw" in
    /*) printf '%s\n' "$raw" ;;
    *)  printf '%s/%s\n' "$(cd "$(dirname "$1")" && pwd)" "$raw" ;;
  esac
}

# Are the two given paths a pair of files, or a pair of directories, with
# identical content? Returns 0 if so, 1 otherwise (including a file paired
# with a directory). Content only: permissions and executable bits are not
# compared, and symlinks inside a directory are followed rather than
# compared as links. A plain copy in the target that matches ours can be
# swapped for a link without --force, since nothing is lost.
same_content() {
  if [ -d "$1" ] && [ -d "$2" ]; then diff -rq "$1" "$2" >/dev/null 2>&1
  elif [ -f "$1" ] && [ -f "$2" ]; then cmp -s "$1" "$2"
  else return 1
  fi
}

main "$@"
