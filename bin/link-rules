#!/usr/bin/env bash
#
# Link this repository's rules into a harness rules directory, one symlink
# per rule file.
#
# Claude Code loads every .md under ~/.claude/rules/ into every session, and
# follows symlinks to find them. Keeping the files here and linking them in
# versions the rules alongside the skills they sit next to.
#
# Safe to re-run. It only ever touches entries it owns.

set -euo pipefail

. "$(dirname "${BASH_SOURCE[0]}")/lib/link.sh"

PROG=link-rules
WHAT=rules
SOURCE_DIR="$REPO_ROOT/rules"
ENV_VAR=JAKE_MODE_RULES_TARGET
TARGET="${JAKE_MODE_RULES_TARGET:-$HOME/.claude/rules}"

parse_args "$@"

[ -d "$SOURCE_DIR" ] || { echo "$PROG: no rules/ directory at $SOURCE_DIR" >&2; exit 1; }

# A rule is any .md file under rules/.
entries=()
while IFS= read -r rule; do
  entries+=("$(cd "$(dirname "$rule")" && pwd)/$(basename "$rule")")
done < <(find "$SOURCE_DIR" -type f -name '*.md' | sort)

entry_live() { [ -f "$1" ]; }

link_entries
