#!/usr/bin/env bash
#
# Flatten this repository's skills into a harness skills directory, one
# symlink per skill.
#
# Harnesses scan only the top level of their skills directory, so a skill
# nested in a category folder is invisible to them. This script bridges that:
# the repo organizes skills however it likes, and the links flatten them at
# the boundary.
#
# Safe to re-run. It only ever touches entries it owns.

set -euo pipefail

. "$(dirname "${BASH_SOURCE[0]}")/lib/link.sh"

PROG=link-skills
WHAT=skills
SOURCE_DIR="$REPO_ROOT/skills"
ENV_VAR=JAKE_MODE_TARGET
TARGET="${JAKE_MODE_TARGET:-$HOME/.claude/skills}"

parse_args "$@"

[ -d "$SOURCE_DIR" ] || { echo "$PROG: no skills/ directory at $SOURCE_DIR" >&2; exit 1; }

# A skill is any directory holding a SKILL.md.
entries=()
while IFS= read -r manifest; do
  entries+=("$(cd "$(dirname "$manifest")" && pwd)")
done < <(find "$SOURCE_DIR" -type f -name SKILL.md | sort)

entry_live() { [ -f "$1/SKILL.md" ]; }

link_entries
